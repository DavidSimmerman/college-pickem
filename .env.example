# Postgres. Coolify fills this in for you when you attach a database to the app.
DATABASE_URL=postgres://user:password@host:5432/pickem
# Set to true only if your Postgres is remote and speaks TLS. Coolify's is on the
# same private network, so leave it off there.
DATABASE_SSL=false
# Pool size. 10 is plenty for a friend-group pick'em.
DATABASE_POOL=10

# Your public URL. SvelteKit rejects form posts whose Origin does not match this,
# so it has to be exact — scheme included, no trailing slash.
ORIGIN=https://pickem.example.com

# Google sign-in. Leave both blank and the button never renders; the passcode
# form works exactly the same either way.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
